{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn",
    "maxWarnings": 0
  },
  "env": {
    "browser": true,
    "es2026": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "react/exhaustive-deps": "error",
    "import/no-cycle": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "unicorn/no-new-array": "warn",
    "react/react-in-jsx-scope": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "max-classes-per-file": ["warn", { "max": 16 }],
    "max-lines": ["warn", { "max": 900 }],
    "max-lines-per-function": ["warn", { "max": 380 }],
    "unicorn/filename-case": [
      "warn",
      {
        "cases": { "kebabCase": true },
        "ignore": ["(^|/)App\\.tsx$", "(^|/)normalizeCandle\\.ts$"]
      }
    ],
    "no-inline-comments": "off",
    "require-unicode-regexp": "off",
    "vitest/require-mock-type-parameters": "warn"
  },
  "overrides": [
    {
      // Every rule below was verified to fire only on these paths; each one
      // encodes a fixture/assertion idiom, not a defect in shipped code.
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        // Untyped test mocks/fixtures; type-aware rules are for production code.
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        // Test-only rule; mocks are structural doubles.
        "vitest/require-mock-type-parameters": "off",
        "no-console": "off",
        "typescript/no-floating-promises": "off",
        "max-lines": "off",
        // Stream fixtures must be driven sequentially to keep emitted order.
        "eslint/no-await-in-loop": "off",
        // A table-driven case is one prose-named test with a long body.
        "eslint/max-lines-per-function": "off",
        // Loop bodies register per-iteration subscribers that outlive the turn.
        "eslint/no-loop-func": "off",
        // Nested fixtures deliberately reuse the domain name being exercised.
        "eslint/no-shadow": "off",
        // Tests reach for `_`-prefixed internals to assert their wiring.
        "eslint/no-underscore-dangle": "off",
        // Async doubles must keep the async signature of the port they replace.
        "eslint/require-await": "off",
        // A test names every collaborator it fakes, so the count is the setup.
        "import/max-dependencies": "off",
        // Setup modules and MSW handlers are imported for their side effects.
        "import/no-unassigned-import": "off",
        // Fixture builders spread one property onto a cloned record.
        "oxc/no-map-spread": "off",
        // Assertions inline a call whose value is discarded, not returned.
        "typescript/no-confusing-void-expression": "off",
        // `toBe(true)` states the expected literal for a boolean-returning port.
        "typescript/no-unnecessary-boolean-literal-compare": "off",
        // Casting a fixture literal to its branded type is the setup step.
        "typescript/no-unnecessary-type-assertion": "off",
        // `String(x)` on a fixture is there to spell the value's shape.
        "typescript/no-unnecessary-type-conversion": "off",
        // Handlers mocked as void are asserted through the returned stub.
        "typescript/strict-void-return": "off",
        // Fake timers and ports stay async to match the real signature.
        "typescript/require-await": "off",
        // Helper factories close over per-test fixtures by design.
        "unicorn/consistent-function-scoping": "off",
        // Object wrappers model the runtime values the code under test receives.
        "unicorn/new-for-builtins": "off",
        // `map(fn)` on a typed array is unambiguous in a fixture pipeline.
        "unicorn/no-array-callback-reference": "off",
        // Fixture order is asserted by mutating the copy the test just built.
        "unicorn/no-array-reverse": "off",
        // Sorted expectations mutate a local fixture array, never shared state.
        "unicorn/no-array-sort": "off",
        // Optional fixture fields are spelled out so the shape stays visible.
        "unicorn/no-useless-undefined": "off",
        // Separate expectations read better as separate `.toHaveBeenCalledWith`.
        "unicorn/prefer-single-call": "off",
        // `expect(() => x).toThrow(new Error(...))` names the error the port raises.
        "unicorn/prefer-type-error": "off",
        // One parameterized test branching per case keeps related cases together.
        "vitest/no-conditional-in-test": "off"
      }
    },
    {
      "files": ["**/*.config.{ts,js,mjs}", "vite.config.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/app/src/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      }
    },
    {
      // Imports are the composition root's job: naming every port in one place
      // is what these files are for, so the dependency count is not a smell.
      "files": [
        "packages/api/app.ts",
        "packages/api/app/services.ts",
        "packages/app/src/services/exchange/index.ts"
      ],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      // The provider is the one adapter that composes the limiter, mapping,
      // dedup and normalizer ports; splitting it would scatter one contract.
      "files": ["packages/api/integrations/hyperliquid/data-sources/provider.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      // Feature components are composition seams: one surface names every hook, block and adapter it renders, so the count is the surface, not a smell. Layouts compose the shell the same way.
      "files": [
        "packages/app/src/features/**/components/**/*.tsx",
        "packages/app/src/layouts/main-layout.tsx"
      ],
      "rules": {
        "import/max-dependencies": ["warn", { "max": 15 }]
      }
    },
    {
      // A composite chart is a single image to assistive tech, and only a wrapper element can carry that one accessible name.
      "files": ["packages/app/src/features/whales/components/long-short-donut.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // Shared sits at the bottom of the workspace graph and must stay a leaf.
      "files": ["packages/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": ["@0xsignal/app", "@0xsignal/api", "@0xsignal/auth"]
          }
        ]
      }
    },
    {
      // Platform is cross-cutting plumbing; module composition happens above it.
      "files": ["packages/api/**/platform/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["@/modules/**"] }]
      }
    },
    {
      // Integrations are adapters; only a module's public surface may be imported, above them.
      "files": ["packages/api/**/integrations/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["@/modules/**"] }]
      }
    },
    {
      // The single sanctioned boundary where `unknown` from the wire becomes a
      // branded domain type; every other cast has to go through these helpers.
      "files": [
        "packages/sdk-hyperliquid/src/core/parse.ts",
        "packages/sdk-hyperliquid/src/core/brands.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      // `cast<T>` exists to name the caller's target type at the parse boundary,
      // so the parameter is the contract, not an unused hole.
      "files": ["packages/sdk-hyperliquid/src/core/parse.ts"],
      "rules": {
        "typescript/no-unnecessary-type-parameters": "off"
      }
    },
    {
      // Composition root for the action registry: naming every action in one
      // place is the point, so the dependency count is the surface, not a smell.
      "files": ["packages/sdk-hyperliquid/src/exchange/actions/index.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      // Sequential stream drain with a running byte cap: awaiting each read
      // keeps ordering and lets the cap stop the loop; parallel reads would not.
      "files": ["packages/sdk-hyperliquid/src/ws/deflate.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // Action files are kebab-case by contract; restated here so the SDK surface
      // keeps the rule if the root default ever loosens.
      "files": ["packages/sdk-hyperliquid/src/exchange/actions/*.ts"],
      "rules": {
        "unicorn/filename-case": [
          "warn",
          {
            "cases": { "kebabCase": true }
          }
        ]
      }
    },
    {
      // Build script outside the TS program (bun/node globals untyped): the unsafe
      // reads and truthiness checks come from missing ambient types, not defects.
      "files": ["packages/app/scripts/**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      // Build-time Node script: its console output is the report, and the Bun/Node
      // globals it probes are ambient here rather than app runtime state.
      "files": ["packages/app/scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // A portalled, non-modal popover positioned from a measured anchor; a native
      // <dialog> cannot carry this fixed placement, so the role stays explicit.
      "files": ["packages/app/src/features/trade/components/trade-dropdown-panel.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // No native resizable-splitter element exists; each grip is a focusable
      // separator that drives the pointer/keyboard resize gesture.
      "files": ["packages/app/src/features/asset-detail/components/resizable-wrapper.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/out/**",
    "**/*.min.js",
    ".agents/**"
  ]
}
