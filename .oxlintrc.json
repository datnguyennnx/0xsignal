{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn",
    "maxWarnings": 0
  },
  "env": {
    "browser": true,
    "es2026": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "react/exhaustive-deps": "error",
    "import/no-cycle": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "unicorn/no-new-array": "warn",
    "react/react-in-jsx-scope": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "max-classes-per-file": ["warn", { "max": 16 }],
    "max-lines": ["warn", { "max": 900 }],
    "max-lines-per-function": ["warn", { "max": 380 }],
    "unicorn/filename-case": [
      "warn",
      {
        "cases": { "kebabCase": true },
        "ignore": ["(^|/)App\\.tsx$", "(^|/)normalizeCandle\\.ts$"]
      }
    ],
    "no-inline-comments": "off",
    "require-unicode-regexp": "off",
    "vitest/require-mock-type-parameters": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/__tests__/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off",
        "typescript/no-floating-promises": "off",
        "max-lines": "off"
      }
    },
    {
      "files": ["**/*.config.{ts,js,mjs}", "vite.config.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/app/src/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      }
    },
    {
      // Imports are the composition root's job: naming every port in one place
      // is what these files are for, so the dependency count is not a smell.
      "files": [
        "packages/api/app.ts",
        "packages/api/app/services.ts",
        "packages/app/src/services/exchange/index.ts"
      ],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      // The provider is the one adapter that composes the limiter, mapping,
      // dedup and normalizer ports; splitting it would scatter one contract.
      "files": ["packages/api/integrations/hyperliquid/data-sources/provider.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      // Feature components are composition seams: one surface names every hook, block and adapter it renders, so the count is the surface, not a smell. Layouts compose the shell the same way.
      "files": [
        "packages/app/src/features/**/components/**/*.tsx",
        "packages/app/src/layouts/main-layout.tsx"
      ],
      "rules": {
        "import/max-dependencies": ["warn", { "max": 15 }]
      }
    },
    {
      // A composite chart is a single image to assistive tech, and only a wrapper element can carry that one accessible name.
      "files": ["packages/app/src/features/whales/components/long-short-donut.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // Shared sits at the bottom of the workspace graph and must stay a leaf.
      "files": ["packages/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": ["@0xsignal/app", "@0xsignal/api", "@0xsignal/auth"]
          }
        ]
      }
    },
    {
      // Platform is cross-cutting plumbing; module composition happens above it.
      "files": ["packages/api/**/platform/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["@/modules/**"] }]
      }
    },
    {
      // Integrations are adapters; only a module's public surface may be imported, above them.
      "files": ["packages/api/**/integrations/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": ["@/modules/**"] }]
      }
    },
    {
      // The single sanctioned boundary where `unknown` from the wire becomes a
      // branded domain type; every other cast has to go through these helpers.
      "files": [
        "packages/sdk-hyperliquid/src/core/parse.ts",
        "packages/sdk-hyperliquid/src/core/brands.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      // `cast<T>` exists to name the caller's target type at the parse boundary,
      // so the parameter is the contract, not an unused hole.
      "files": ["packages/sdk-hyperliquid/src/core/parse.ts"],
      "rules": {
        "typescript/no-unnecessary-type-parameters": "off"
      }
    },
    {
      // Composition root for the action registry: naming every action in one
      // place is the point, so the dependency count is the surface, not a smell.
      "files": ["packages/sdk-hyperliquid/src/exchange/actions/index.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      // Sequential stream drain with a running byte cap: awaiting each read
      // keeps ordering and lets the cap stop the loop; parallel reads would not.
      "files": ["packages/sdk-hyperliquid/src/ws/deflate.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // Action files are kebab-case by contract; restated here so the SDK surface
      // keeps the rule if the root default ever loosens.
      "files": ["packages/sdk-hyperliquid/src/exchange/actions/*.ts"],
      "rules": {
        "unicorn/filename-case": [
          "warn",
          {
            "cases": { "kebabCase": true }
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/out/**",
    "**/*.min.js",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    ".agents/**"
  ]
}
