{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "env": {
    "browser": true,
    "es2026": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "react/exhaustive-deps": "error",
    "import/no-cycle": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "unicorn/no-new-array": "warn",
    "react/react-in-jsx-scope": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "max-classes-per-file": ["warn", { "max": 16 }],
    "max-lines": ["warn", { "max": 550 }],
    "max-lines-per-function": ["warn", { "max": 380 }],
    "unicorn/filename-case": [
      "warn",
      {
        "cases": { "kebabCase": true },
        "ignore": ["(^|/)App\\.tsx$", "(^|/)normalizeCandle\\.ts$"]
      }
    ],
    "no-inline-comments": "off",
    "require-unicode-regexp": "off",
    "vitest/require-mock-type-parameters": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/__tests__/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-console": "off",
        "typescript/no-floating-promises": "off",
        "max-lines": "off"
      }
    },
    {
      "files": ["**/*.config.{ts,js,mjs}", "**/scripts/**", "vite.config.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/app/src/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      }
    },
    {
      // Imports are the composition root's job: naming every port in one place
      // is what these files are for, so the dependency count is not a smell.
      "files": ["packages/api/app.ts", "packages/api/app/services.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      // The provider is the one adapter that composes the limiter, mapping,
      // dedup and normalizer ports; splitting it would scatter one contract.
      "files": ["packages/api/integrations/hyperliquid/data-sources/provider.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/out/**",
    "**/*.tsbuildinfo",
    "**/*.min.js"
  ]
}
