{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": false,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "error",
    "types": "error",
    "unresolved": "warn",
    "duplicates": "off",
    // knip skips type-only import edges, so it cannot detect the type-only cycles the old depcruise gate reported.
    "cycles": "off",
  },
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
    },
    "packages/app": {
      "entry": ["src/services/api/index.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      // Consumed from CSS, not JS: src/index.css @imports both, with the @tailwindcss/vite plugin wired in vite.config.ts. Do not delete these packages.
      // Knip resolves import statements, not Vite `resolve.alias` string targets, so
      // this shim (aliased for `node:worker_threads` in vite.config.ts) is invisible to it. Do not delete it.
      "ignore": ["src/lib/node-worker-threads-shim.ts"],
    },
    "packages/api": {
      "project": ["**/*.ts"],
    },
    "packages/auth": {
      "project": ["src/**/*.ts"],
      "ignoreExportsUsedInFile": {
        "type": true,
        "interface": true,
      },
    },
    "packages/shared": {
      "project": ["**/*.ts"],
      "ignoreExportsUsedInFile": {
        "type": true,
      },
    },
    // Library: entries are derived from package.json `exports` (the single source of truth).
    // Entry exports are public by definition, so they are excluded from the report;
    // anything still reported is unreferenced outside its own file.
    "packages/sdk-hyperliquid": {
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "includeEntryExports": false,
      "ignoreExportsUsedInFile": true,
    },
  },
}
