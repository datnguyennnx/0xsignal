{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "objectWrap": "preserve",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "**/node_modules",
    "dist",
    "build",
    ".next",
    ".turbo",
    "out",
    "coverage",
    "*.tsbuildinfo",
    "*.min.js",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "lerna-debug.log*",
    ".DS_Store",
    "*.pem",
    ".env",
    ".env.local",
    ".env.production.local",
    ".env.development.local",
    ".idea",
    "package-lock.json",
    "yarn.lock",
    "bun.lock",
    "*.d.ts.map"
  ]
}
