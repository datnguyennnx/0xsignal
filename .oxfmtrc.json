{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "objectWrap": "preserve",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "build",
    ".next",
    "out",
    "coverage",
    "*.min.js",
    "*.pem",
    "package-lock.json",
    "yarn.lock",
    "*.d.ts.map"
  ]
}
