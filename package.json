{
  "name": "0xsignal-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.10",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:strict": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix .",
    "lint:rules": "oxlint --print-config .",
    "typecheck": "turbo run typecheck",
    "start": "docker compose -f deploy/docker-compose.yml build && docker compose -f deploy/docker-compose.yml up -d",
    "down": "docker compose -f deploy/docker-compose.yml down",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "depcruise": "bun --bun ./node_modules/.bin/depcruise \"packages/**/*.ts\" \"packages/**/*.tsx\" --config .dependency-cruiser.cjs --cache",
    "knip": "knip",
    "knip:prod": "knip --production --strict",
    "knip:fix": "knip --fix-type exports,types",
    "db:up": "docker compose -f deploy/dev/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/dev/docker-compose.yml down",
    "db:logs": "docker compose -f deploy/dev/docker-compose.yml logs -f postgres",
    "clean:all": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "prepare": "husky",
    "doctor": "react-doctor --scope changed --blocking warning --no-score --no-supply-chain --include-untracked",
    "doctor:full": "react-doctor --blocking error --no-score --no-supply-chain"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "latest",
    "react-doctor": "^0.9.18",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md,css}": [
      "oxfmt --write"
    ]
  }
}
