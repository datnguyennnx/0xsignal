{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json", "package.json", "bun.lock"],
  "concurrency": "100%",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
