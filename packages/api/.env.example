# API Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=9006
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Database Connections
POSTGRES_HOST=localhost
POSTGRES_PORT=54322
POSTGRES_DB=0xsignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=postgresql://postgres:postgres@localhost:54322/0xsignal

# ─── Auth Configuration ──────────────────────────────────────────
# JWT (MUST change in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-256-bit-key-min-32-chars

# Frontend URL (controls CORS)
# Local dev: http://localhost:5173
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# Refresh cookie security. Secure is ON by default at every hostname.
# Set INSECURE_COOKIES=true ONLY for local HTTP development where the browser
# would reject a Secure cookie. The server logs a warning on every issuance.
# NEVER set this in production.
INSECURE_COOKIES=false

# OAuth Provider Configuration
# For production, use your actual OAuth credentials from:
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:9006/api/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:9006/api/auth/github/callback

# ─── Whale Position Poller ───────────────────────────────────────
# Hyperliquid REST weight is shared per IP. The shared limiter enforces both
# caps below (weight, not call count).
HL_RATE_WEIGHT_PER_SECOND=20
HL_RATE_WEIGHT_PER_MINUTE=600
# Budget cap, not a tuning knob: the ceiling is 50 (50 x weight 2 + allMids
# weight 2 = 102 per tick against the shared 1200/min upstream budget).
# Values above 50 fail startup instead of being silently clamped.
WHALE_MAX_WALLETS_PER_POLL=50
WHALE_POLL_INTERVAL_MS=60000
