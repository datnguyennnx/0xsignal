{
  "name": "@0xsignal/sdk-hyperliquid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./info": "./src/api/info/index.ts",
    "./exchange": "./src/api/exchange/index.ts",
    "./actions": "./src/api/actions/index.ts",
    "./subscription": "./src/api/subscription/index.ts",
    "./signing": "./src/signing/index.ts",
    "./core": "./src/core/brands.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "gen:vectors": "python3 scripts/gen-l1-vectors.py",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.3",
    "typescript": "7.0.2"
  }
}
